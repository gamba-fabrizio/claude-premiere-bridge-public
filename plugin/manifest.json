{
  "id": "com.tuusuario.premierebridge",
  "name": "Claude Bridge",
  "shortname": "ppbridge",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "id": "bridgepanel",
      "type": "panel",
      "minimumSize": { "width": 240, "height": 200 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 280, "height": 260 },
      "preferredFloatingSize": { "width": 320, "height": 300 },
      "label": { "default": "Claude Bridge" }
    }
  ]
}
